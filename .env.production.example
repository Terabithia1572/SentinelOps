# ==============================================================================
# SentinelOps — Production Environment Configuration Template (.env.production)
# Instructions:
# 1. Copy this file to .env.production on the target host.
# 2. Generate cryptographically strong random secrets for all REPLACE_* placeholders.
# 3. Ensure file permissions are restricted (e.g., chmod 600 .env.production).
# 4. NEVER commit real production .env files to source control.
# ==============================================================================

# Core ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DOTNET_PRINT_TELEMETRY_MESSAGE=false
DOTNET_CLI_TELEMETRY_OPTOUT=1

# PostgreSQL High-Availability / Managed Cluster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PG_PASSWORD_AT_LEAST_32_CHARS

# Database Connection Pool Sizing
# Maximum Pool Size=100;Minimum Pool Size=10;Connection Idle Lifetime=60;Timeout=15;Command Timeout=30;
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=sentinelops;Username=sentinelops_app;Password=REPLACE_WITH_STRONG_PG_PASSWORD_AT_LEAST_32_CHARS;Maximum Pool Size=100;Minimum Pool Size=10;Connection Idle Lifetime=60;Timeout=15;

# Redis Streams & Cache Clustered Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
ConnectionStrings__Redis=redis:6379,password=REPLACE_WITH_STRONG_REDIS_PASSWORD,abortConnect=false,connectTimeout=5000,syncTimeout=5000

# Cryptographic Identity & JWT Bearer Token Security
# Minimum 256-bit (32 bytes) key; 512-bit recommended for production
JwtSettings__Key=REPLACE_WITH_HIGH_ENTROPY_JWT_SIGNING_KEY_MIN_64_CHARS
JwtSettings__Issuer=https://sentinelops.yourdomain.com
JwtSettings__Audience=https://sentinelops.yourdomain.com
JwtSettings__ExpirationMinutes=60

# Production CORS Whitelist (comma-delimited or JSON array)
CorsSettings__AllowedOrigins__0=https://sentinelops.yourdomain.com

# OpenTelemetry Ingestion & Collector Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=sentinelops-platform

# Production Feature Gates
SENTINELOPS_ENABLE_SWAGGER=false
SENTINELOPS_ENFORCE_HTTPS=true
SENTINELOPS_REQUIRE_CONFIRMED_EMAIL=true
