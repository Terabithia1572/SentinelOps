# .dockerignore for SentinelOps
# Exclude version control metadata
.git/
.gitignore
.gitattributes

# Exclude build and package outputs (CRITICAL: prevents Windows NuGet assets from leaking into Linux build)
**/bin/
**/obj/
**/out/
**/dist/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude test and coverage outputs
**/TestResults/
**/testresults/
**/coverage/
**/.coverage/

# Exclude IDE and OS metadata
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.sln.docstates
.DS_Store
Thumbs.db

# Exclude logs and temporary files
*.log
**/logs/
**/temp/
**/tmp/

# Exclude local secrets, overrides, backups, and dumps
**/.env
**/.env.*
!**/.env.example
**/appsettings.Local.json
**/appsettings.*.local.json
**/appsettings.*.Local.json
**/*.key
**/*.pfx
**/*.pem
backups/
*.dump
*.bak

# Exclude documentation and local screenshots (reduces build context size)
docs/
README.md

# Exclude test, benchmark, and tooling projects (not needed in production container images)
tests/
tools/
samples/

# Exclude Kubernetes and Helm charts (reduces build context size)
deploy/k8s/
deploy/helm/
