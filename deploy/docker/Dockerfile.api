FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/Directory.Build.props", "src/"]
COPY ["src/SentinelOps.Domain/SentinelOps.Domain.csproj", "src/SentinelOps.Domain/"]
COPY ["src/SentinelOps.Contracts/SentinelOps.Contracts.csproj", "src/SentinelOps.Contracts/"]
COPY ["src/SentinelOps.Application/SentinelOps.Application.csproj", "src/SentinelOps.Application/"]
COPY ["src/SentinelOps.Infrastructure/SentinelOps.Infrastructure.csproj", "src/SentinelOps.Infrastructure/"]
COPY ["src/SentinelOps.Api/SentinelOps.Api.csproj", "src/SentinelOps.Api/"]
RUN dotnet restore "src/SentinelOps.Api/SentinelOps.Api.csproj"

COPY src/ src/
WORKDIR "/src/src/SentinelOps.Api"
RUN dotnet build "SentinelOps.Api.csproj" -c Release -o /app/build --no-restore

FROM build AS publish
RUN dotnet publish "SentinelOps.Api.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish --chown=app:app /app/publish .
USER app

ENTRYPOINT ["dotnet", "SentinelOps.Api.dll"]
