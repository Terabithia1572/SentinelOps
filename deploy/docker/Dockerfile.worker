FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/Directory.Build.props", "src/"]
COPY ["src/SentinelOps.Domain/SentinelOps.Domain.csproj", "src/SentinelOps.Domain/"]
COPY ["src/SentinelOps.Contracts/SentinelOps.Contracts.csproj", "src/SentinelOps.Contracts/"]
COPY ["src/SentinelOps.Application/SentinelOps.Application.csproj", "src/SentinelOps.Application/"]
COPY ["src/SentinelOps.Infrastructure/SentinelOps.Infrastructure.csproj", "src/SentinelOps.Infrastructure/"]
COPY ["src/SentinelOps.Worker/SentinelOps.Worker.csproj", "src/SentinelOps.Worker/"]
RUN dotnet restore "src/SentinelOps.Worker/SentinelOps.Worker.csproj"

COPY src/ src/
WORKDIR "/src/src/SentinelOps.Worker"
RUN dotnet build "SentinelOps.Worker.csproj" -c Release -o /app/build --no-restore

FROM build AS publish
RUN dotnet publish "SentinelOps.Worker.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish --chown=app:app /app/publish .
USER app

ENTRYPOINT ["dotnet", "SentinelOps.Worker.dll"]
